      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet transcriptText = \"\";\nlet transcriptHtml = \"<ul>\";\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  \n  //const sessionId = row.session_id;\n  \n  // Extract text from the n8n jsonb structure (message -> data -> content)\n  const text = row.message?.content || \"No message content\";\n  \n  // Determine if the sender is the User or the AI Agent\n  const type = row.message?.type;\n  const sender = type === 'human' ? 'User' : 'Agent';\n  \n  // Format the timestamp cleanly\n  const time = row.entry_timestamp ? new Date(row.entry_timestamp).toLocaleTimeString() : '';\n\n  // Append to the plain text formatting\n  transcriptText += `[${time}] ${sender}: ${text}\\n`;\n  \n  // Append to the HTML formatting\n  transcriptHtml += `<li><strong>[${time}] ${sender}:</strong> ${text}</li>`;\n}\n\ntranscriptHtml += \"</ul>\";\n\n\n// return $input.all();\n// Output both formats so you can use whichever you need downstream\nreturn [{\n  json: {\n    sessionId: $input.all()[0]?.json.session_id,\n    plainTextTranscript: transcriptText.trim(),\n    htmlTranscript: transcriptHtml\n  }\n}];"
      },
